# Copy to `.env.local` and fill in from your Supabase project (Settings → API).
# Until these are set, the deal tools run in full preview mode without sign-in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — Strategy Generator (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Research warehouse (Sprint 2+): Postgres connection string for the
# warehouse-validation Supabase BRANCH only (Dashboard → select the
# warehouse-validation branch → Connect → Session pooler). The loader refuses
# any URL that is not the branch (ref lzonauinzatmtytyoems) and never prints it.
# WAREHOUSE_VALIDATION_DB_URL=postgresql://postgres.lzonauinzatmtytyoems:...@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Sprint 9: /research (Suburb Intelligence preview) — reads the warehouse-
# validation branch's public read-only views (see warehouse/docs/
# WAREHOUSE_READONLY_ACCESS_DESIGN.md). The anon key below is NOT a secret
# (Supabase anon keys are designed for public/client exposure, protected by
# grants) but this feature only ever fetches it server-side. Disabled by
# default in production — WAREHOUSE_PREVIEW_ENABLED must be explicitly true.
# WAREHOUSE_SUPABASE_URL=https://lzonauinzatmtytyoems.supabase.co
# WAREHOUSE_SUPABASE_ANON_KEY=your-branch-anon-key
# WAREHOUSE_PREVIEW_ENABLED=false

# Sprint 11: sub-feature flags under /research, each independent of the
# others and of WAREHOUSE_PREVIEW_ENABLED (all flags an interface needs must
# be true — see lib/warehouse/env.ts for exact gating per route). Every flag
# defaults to disabled (false/absent) unless set to the exact string "true".
# - MULTI_STATE_RESEARCH_ENABLED: /research/explore, /research/map,
#   /research/compare (also currently doubles as the map's national-coverage
#   gate — see app/research/map/page.tsx; a dedicated NATIONAL_MAP_ENABLED
#   was considered in WS18 and deliberately deferred, since the map has no
#   behaviour that diverges from multi-state research yet).
# - DATA_OPERATIONS_ENABLED (WS18): /research/data-status operations console.
# - SCENARIO_LAB_ENABLED (WS18): /research/scenario, added ahead of the
#   route's build (Sprint 12 Part C) so staging config doesn't need a later
#   env var addition.
# MULTI_STATE_RESEARCH_ENABLED=false
# DATA_OPERATIONS_ENABLED=false
# SCENARIO_LAB_ENABLED=false

# Sprint 12 WS11: /api/v1/* — the versioned public research API (search,
# snapshot, timeseries, compare, map-markers, per-metric lineage, quality
# summary, freshness). Independent of WAREHOUSE_PREVIEW_ENABLED (the
# internal /research UI's own flag) since this API may be consumed by
# external callers, not just this app. See warehouse/docs/
# PUBLIC_API_V1_CONTRACT.md.
# PUBLIC_API_V1_ENABLED=false

# Sprint 14 WS5: /research/copilot and /api/research/copilot — grounded AI
# research assistant. Reuses ANTHROPIC_API_KEY above, no separate provider
# credential. Defaults to disabled; the backing migration
# (042_research_copilot_queries.sql) must also be applied before this does
# anything even if the flag is true.
# RESEARCH_COPILOT_ENABLED=false

# Sprint 14 WS20: /admin — read-only beta admin view. BOTH of the following
# must be set for the page to show any cross-user data; either one missing
# leaves it completely inert. SUPABASE_SERVICE_ROLE_KEY bypasses row level
# security entirely — never prefix it with NEXT_PUBLIC_ (that would bundle
# it into client-side JavaScript), and set ADMIN_EMAILS to the fewest real
# addresses necessary. See warehouse/reports/sprint14_ws20_beta_admin_report.md
# and sprint15_security_report.md before configuring either of these.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Supabase Dashboard -> Settings -> API -> service_role key)
# ADMIN_EMAILS=founder@example.com

# Optional: non-Propellect deploys (e.g. Vercel preview). Propellect production always uses
# https://www.propellect.com.au for magic-link emailRedirectTo (apex and www are normalised in code).
# Local dev uses the current browser origin (localhost).
# NEXT_PUBLIC_SITE_URL=https://preview.example.vercel.app

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: https://www.propellect.com.au (recommended)
# - Redirect URLs: must include https://www.propellect.com.au/auth/callback and
#   http://localhost:3000/auth/callback (adjust port if needed). You may still add the apex URL if
#   you serve it, but magic links always target the www callback.
